{
  "name": "editor-extensions",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev:demo": "vp run --filter ./demos/page-editor dev",
    "build:demo": "vp run --filter ./demos/page-editor build",
    "build": "vp exec tsc --noEmit -p tsconfig.build.json && vp run --filter ./packages/* build",
    "test": "vp test --dom",
    "ready": "vp check"
  },
  "devDependencies": {
    "@tiptap/core": "catalog:",
    "@tiptap/pm": "catalog:",
    "@tiptap/starter-kit": "catalog:",
    "happy-dom": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.3.4",
      "onFail": "download"
    }
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
